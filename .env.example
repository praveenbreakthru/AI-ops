# ==============================================================================
# Windows AIOps Platform - Pure Full-Stack Environment Example
# ==============================================================================

# Network Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database (High-Speed Local Embedded SQLite - 0 Docker, 0 Port Bindings)
DATABASE_URL=sqlite:///./data/aiops_local.db

# AI & LLM Engine (Optional Local Ollama with Grounded Statistical Fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=10

# Controlled Remediation Safeguards
REMEDIATION_MODE=manual_approval
MAX_AUTO_ACTIONS_PER_HOUR=3
AUDIT_LOG_PATH=./logs/remediation_audit.log

# Remote Linux Server Credentials
LINUX_SERVER_HOST=172.16.10.29
LINUX_SERVER_PORT=22
LINUX_SERVER_USER=administrator
LINUX_SERVER_PASSWORD=Breakthru@123

