# ==============================================================================
# Windows AIOps Platform - Environment Configuration
# ==============================================================================

# Core Ports
WINDOWS_EXPORTER_PORT=9182
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
ALERTMANAGER_PORT=9093
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Grafana Security
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_aiops_change_me

# PostgreSQL (Port 5433 prevents collisions with pre-installed Windows PostgreSQL 18 on 5432)
POSTGRES_PORT=5433
POSTGRES_USER=aiops
POSTGRES_PASSWORD=aiops_secure_local_dev
POSTGRES_DB=aiops_platform
DATABASE_URL=postgresql://aiops:aiops_secure_local_dev@localhost:5433/aiops_platform

# Prometheus & Loki Endpoints
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
ALERTMANAGER_URL=http://localhost:9093
WINDOWS_EXPORTER_URL=http://localhost:9182

# AI & LLM Settings (Ollama is optional; statistical fallbacks operate when offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=30

# Remediation Configuration
REMEDIATION_MODE=manual_approval
MAX_AUTO_ACTIONS_PER_HOUR=3
AUDIT_LOG_PATH=./logs/remediation_audit.log
