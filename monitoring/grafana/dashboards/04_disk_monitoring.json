  "panels": [
    {
      "id": 1,
      "title": "Disk Volume Capacity & Free Space",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "windows_logical_disk_free_bytes",
          "legendFormat": "Free {{volume}}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 2,
      "title": "Disk Free Space %",
      "type": "gauge",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "100 * (windows_logical_disk_free_bytes / windows_logical_disk_size_bytes)",
          "legendFormat": "Free % {{volume}}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 3,
      "title": "Disk Read & Write Throughput",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "rate(windows_logical_disk_read_bytes_total[1m])",
          "legendFormat": "Read {{volume}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "rate(windows_logical_disk_write_bytes_total[1m])",
          "legendFormat": "Write {{volume}}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
    },
    {
      "id": 4,
      "title": "Disk Idle Time %",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "rate(windows_logical_disk_idle_seconds_total[1m]) * 100",
          "legendFormat": "Idle % {{volume}}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    }
  ],
