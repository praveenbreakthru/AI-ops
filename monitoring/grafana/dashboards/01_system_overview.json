  "panels": [
    {
      "id": 1,
      "title": "System Uptime",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "(time() - windows_system_boot_time_timestamp) / 86400",
          "legendFormat": "Days Uptime"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 2,
      "title": "CPU Utilization",
      "type": "gauge",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "100 - (avg by (instance) (rate(windows_cpu_time_total{mode='idle'}[1m])) * 100)",
          "legendFormat": "CPU %"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "RAM Utilization",
      "type": "gauge",
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "100 * (1 - (windows_memory_available_bytes / windows_os_visible_memory_bytes))",
          "legendFormat": "RAM %"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 92
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Disk Free Space (C:)",
      "type": "gauge",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "100 * (windows_logical_disk_free_bytes{volume='C:'} / windows_logical_disk_size_bytes{volume='C:'})",
          "legendFormat": "Free C: %"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "green",
                "value": 25
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Battery Level",
      "type": "stat",
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "windows_hardware_battery_percent",
          "legendFormat": "Battery"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "CPU & Memory Utilization History",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "100 - (avg by (instance) (rate(windows_cpu_time_total{mode='idle'}[1m])) * 100)",
          "legendFormat": "CPU Utilization %"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "100 * (1 - (windows_memory_available_bytes / windows_os_visible_memory_bytes))",
          "legendFormat": "RAM Utilization %"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 7,
      "title": "Network Throughput",
      "type": "timeseries",
      "gridPos": {
        "x": 14,
        "y": 5,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(rate(windows_net_bytes_received_total[1m])) * 8",
          "legendFormat": "Download (bps)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(rate(windows_net_bytes_sent_total[1m])) * 8",
          "legendFormat": "Upload (bps)"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        }
      }
    },
    {
      "id": 8,
      "title": "Recent Error / Warning Logs",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "{job=\"windows_event_logs\"} |= \"error\" or {job=\"windows_event_logs\"} |= \"warning\"",
          "maxLines": 100
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
