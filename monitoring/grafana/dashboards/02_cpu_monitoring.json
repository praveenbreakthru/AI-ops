  "panels": [
    {
      "id": 1,
      "title": "Total CPU Usage %",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "100 - (avg by (instance) (rate(windows_cpu_time_total{mode='idle'}[1m])) * 100)",
          "legendFormat": "Total CPU %"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 2,
      "title": "Per-Core CPU Utilization %",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "100 - (rate(windows_cpu_time_total{mode='idle'}[1m]) * 100)",
          "legendFormat": "Core {{core}}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 3,
      "title": "CPU Utilization by Execution Mode",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "avg by (mode) (rate(windows_cpu_time_total[1m]) * 100)",
          "legendFormat": "Mode: {{mode}}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 4,
      "title": "Core Frequencies",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "windows_cpu_core_frequency_hertz / 1e9",
          "legendFormat": "Core {{core}} (GHz)"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "hertz",
          "decimals": 2
        }
      }
    },
    {
      "id": 5,
      "title": "Interrupts & Context Switches",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "rate(windows_system_context_switches_total[1m])",
          "legendFormat": "Context Switches/sec"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(rate(windows_cpu_clock_interrupts_total[1m]))",
          "legendFormat": "Clock Interrupts/sec"
        }
      ],
